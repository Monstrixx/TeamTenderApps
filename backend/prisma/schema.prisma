  highestEducation     String?
  activeSKK            Int      @default(0)
  expiredSKK           Int      @default(0)
  verifiedSkills       Int      @default(0)
  totalYearsExperience Int      @default(0)
  highestProjectValue  Decimal?
  managementExperience Boolean  @default(false)

  rawText        String? @db.Text
  featureVersion Int     @default(1)

  generatedAt DateTime @default(now())

  @@index([personnelId])
}

model ResumeTemplate {
  id String @id @default(cuid())

  name            String
  version         Int    @default(1)
  owner           String // e.g. "SYSTEM" or "USER"
  supportedFormat String // JSON string e.g. '["HTML", "PDF", "DOCX"]'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// WAVE 5.7: INTELLIGENT DOCUMENT PLATFORM
// ==========================================

enum DocumentStatus {
  UPLOADED
  HASHED
  SCANNED
  OCR_COMPLETED
  CLASSIFIED
  VERIFIED
  SIGNED
  ARCHIVED
  EXPIRED
}

enum DocumentClassification {
  IDENTITY
  LEGAL
  CERTIFICATE
  CONTRACT
  FINANCIAL
  TECHNICAL
  PHOTO
  OTHER
}

enum MetadataValueType {
  STRING
  NUMBER
  DATE
  BOOLEAN
  JSON
}

enum DocumentStorageProvider {
  LOCAL
  S3
  GCS
  AZURE
}

model Document {
  id               String                  @id @default(cuid())
  workspaceId      String
  companyId        String?
  code             String                  @unique
  slug             String                  @unique
  version          Int                     @default(1)
  status           DocumentStatus          @default(UPLOADED)
  mimeType         String
  extension        String
  size             Int
  sha256           String
  storageProvider  DocumentStorageProvider @default(LOCAL)
  providerVersion  String?
  storageKey       String
  originalFilename String
  displayName      String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions      DocumentVersion[]
  metadata      DocumentMetadata[]
  permissions   DocumentPermission[]
  featureVector DocumentFeatureVector?
  embeddings    DocumentEmbedding[]

  // Relations to other aggregates
  companyDocuments         CompanyDocument[]
  personnelDocuments       PersonnelDocument[]
  tenderPersonnelDocuments TenderPersonnelDocument[]
  personnelSKKs            PersonnelSKK[]
  skkHistories             PersonnelSKKHistory[]
  personnelEducations      PersonnelEducation[]
  supplierQualifications   SupplierQualification[]
  equipmentCertifications  EquipmentCertification[]
  equipmentMaintenances    EquipmentMaintenance[]
  equipmentDocuments       EquipmentDocument[]
  tenderDocuments          TenderDocument[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([sha256])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int
  storageKey    String
  sha256        String
  size          Int
  changeReason  String?

  createdAt DateTime @default(now())

  @@index([documentId])
}

model DocumentMetadata {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  key       String
  value     String            @db.Text
  valueType MetadataValueType @default(STRING)

  @@index([documentId])
}

enum EntityType {
  WORKSPACE
  COMPANY
  PERSONNEL
  TENDER
  EQUIPMENT
  SUPPLIER
  DOCUMENT
}

model DocumentPermission {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  entityType  EntityType
  entityId    String
  accessLevel String // e.g. READ, WRITE, ADMIN
  inherited   Boolean    @default(true)

  @@index([documentId])
  @@index([entityType, entityId])
}

model DocumentFeatureVector {
  id         String   @id @default(cuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  classification           DocumentClassification?
  classificationConfidence Decimal?
  ocrCompleteness          Decimal?

  language          String?
  pageCount         Int?
  containsSignature Boolean @default(false)
  containsStamp     Boolean @default(false)
  containsQRCode    Boolean @default(false)
  containsTable     Boolean @default(false)

  extractedEntitiesJSON String? @db.Text

  generatedAt DateTime @default(now())
}

model DocumentEmbedding {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  provider  String
  model     String
  dimension Int
  version   Int    @default(1)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// ==========================================
// WAVE 5.8: EQUIPMENT & ASSET DOMAIN
// ==========================================

enum OperationalStatus {
  AVAILABLE
  ASSIGNED
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum OwnershipStatus {
  OWNED
  LEASED
  RENTED
  BORROWED
}

model EquipmentCategory {
  id          String  @id @default(cuid())
  workspaceId String
  code        String?
  name        String
  description String?
  isActive    Boolean @default(true)

  parentId String?
  parent   EquipmentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EquipmentCategory[] @relation("CategoryHierarchy")

  equipment Equipment[]

  @@index([workspaceId])
  @@index([parentId])
}

model Equipment {
  id          String @id @default(cuid())
  workspaceId String
  companyId   String

  code    String @unique
  slug    String @unique
  version Int    @default(1)

  name         String
  brand        String
  model        String
  serialNumber String?
  assetNumber  String?
  categoryId   String

  status    OperationalStatus @default(AVAILABLE)
  ownership OwnershipStatus   @default(OWNED)

  year            Int?
  purchaseDate    DateTime?
  purchasePrice   Decimal?
  currentLocation String?
  notes           String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  category                   EquipmentCategory           @relation(fields: [categoryId], references: [id])
  specifications             EquipmentSpecification[]
  certifications             EquipmentCertification[]
  maintenance                EquipmentMaintenance[]
  usage                      EquipmentUsage[]
  assignments                EquipmentAssignment[]
  documents                  EquipmentDocument[]
  featureVector              EquipmentFeatureVector?
  embeddings                 EquipmentEmbedding[]
  tenderEquipmentAssignments TenderEquipmentAssignment[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
}

model EquipmentSpecification {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  key   String
  value String
  unit  String?

  @@index([equipmentId])
}

model EquipmentCertification {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  certificateType   String // e.g., SIA, SILO, Calibration
  certificateNumber String
  issuedDate        DateTime
  expiredDate       DateTime
  issuingAuthority  String?

  verificationStatus    VerificationStatus @default(PENDING)
  verificationProvider  String?
  verificationReference String?
  verifiedAt            DateTime?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([documentId])
}

model EquipmentMaintenance {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  maintenanceType String
  scheduledDate   DateTime?
  completedDate   DateTime?
  vendor          String?
  totalCost       Decimal?  @default(0)
  status          String? // e.g. PLANNED, IN_PROGRESS, COMPLETED

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  items EquipmentMaintenanceItem[]

  @@index([equipmentId])
}

model EquipmentMaintenanceItem {
  id            String               @id @default(cuid())
  maintenanceId String
  maintenance   EquipmentMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  itemName   String
  itemType   String? // e.g. SPARE_PART, LABOR, SERVICE
  quantity   Decimal @default(1)
  unitPrice  Decimal @default(0)
  totalPrice Decimal @default(0)

  @@index([maintenanceId])
}

model EquipmentUsage {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  projectId String?
  tenderId  String?
  operator  String?

  startDate    DateTime
  endDate      DateTime
  workingHours Int      @default(0)
  idleHours    Int      @default(0)

  notes String?

  createdAt DateTime @default(now())

  @@index([equipmentId])
}

model EquipmentAssignment {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  companyId   String?
  personnelId String?
  projectId   String?
  tenderId    String?

  assignedAt DateTime  @default(now())
  releasedAt DateTime?

  notes String?

  @@index([equipmentId])
}

model EquipmentDocument {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([documentId])
}

model EquipmentFeatureVector {
  id          String    @id @default(cuid())
  equipmentId String    @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  age                  Int     @default(0)
  utilizationRate      Decimal @default(0.0)
  maintenanceFrequency Int     @default(0)
  downtimeRatio        Decimal @default(0.0)
  activeCertificates   Int     @default(0)
  replacementRisk      Decimal @default(0.0)

  // Advanced predictive maintenance fields
  averageMaintenanceCost Decimal @default(0.0)
  averageRepairInterval  Int     @default(0) // in days
  totalWorkingHours      Int     @default(0)
  lastMaintenanceAge     Int     @default(0) // in days
  certificateExpiryDays  Int     @default(0)

  featureVersion Int     @default(1)
  generatedBy    String?

  generatedAt DateTime @default(now())
}

model EquipmentEmbedding {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  provider  String
  model     String
  dimension Int
  version   Int    @default(1)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([equipmentId])
}

// ==========================================
// WAVE 5.9: TENDER DOMAIN (ORCHESTRATOR)
// ==========================================

enum TenderStatus {
  DRAFT
  PUBLISHED
  BIDDING
  CLOSED
  EVALUATION
  NEGOTIATION
  AWARDED
  CONTRACTED
  COMPLETED
  FAILED
  CANCELLED
}

enum TenderDocumentType {
  RFP
  BOQ
  DRAWING
  ADDENDUM
  BID
  CONTRACT
  MINUTES
  OTHER
}

enum AssignmentStatus {
  PROPOSED
  APPROVED
  REJECTED
  REPLACED
}

enum TenderSupplierStatus {
  INVITED
  INTERESTED
  BID_SUBMITTED
  SHORTLISTED
  REJECTED
  WINNER
}

model Tender {
  id          String @id @default(cuid())
  workspaceId String
  companyId   String

  code    String @unique
  slug    String @unique
  version Int    @default(1)

  title       String
  description String?  @db.Text
  budget      Decimal?
  currency    String   @default("IDR")

  // Expanded operational fields
  procurementMethod    String?
  procurementType      String?
  estimatedDuration    Int? // in days
  visibility           String  @default("PUBLIC") // PUBLIC or PRIVATE
  confidentialityLevel String  @default("STANDARD")

  status TenderStatus @default(DRAFT)

  publishedAt         DateTime?
  submissionDeadline  DateTime?
  evaluationStartDate DateTime?
  awardedAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Orchestration relations
  personnelRequirements TenderPersonnelRequirement[]
  equipmentRequirements TenderEquipmentRequirement[]

  suppliers   TenderSupplier[]
  personnel   TenderPersonnelAssignment[]
  equipment   TenderEquipmentAssignment[]
  documents   TenderDocument[]
  evaluations TenderEvaluation[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([status])
}

// --- Requirements ---

model TenderPersonnelRequirement {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  role               String
  quantity           Int    @default(1)
  minExperienceYears Int?

  // Explicit relations instead of JSON
  requiredSkills         TenderRequiredSkill[]
  requiredCertifications TenderRequiredCertification[]

  assignments TenderPersonnelAssignment[]

  @@index([tenderId])
}

model TenderRequiredSkill {
  id            String                     @id @default(cuid())
  requirementId String
  requirement   TenderPersonnelRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  skillName String
  minLevel  String? // e.g. INTERMEDIATE, ADVANCED

  @@index([requirementId])
}

model TenderRequiredCertification {
  id            String                     @id @default(cuid())
  requirementId String
  requirement   TenderPersonnelRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  certificateType String
  minLevel        String?

  @@index([requirementId])
}

model TenderEquipmentRequirement {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  categoryId  String? // Reference to EquipmentCategory if needed, or free text
  category    String // e.g. "Excavator"
  quantity    Int     @default(1)
  minCapacity String?
  minYear     Int?

  assignments TenderEquipmentAssignment[]

  @@index([tenderId])
}

// --- Suppliers & Assignments ---

model TenderSupplier {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status    TenderSupplierStatus @default(INVITED)
  bidAmount Decimal?

  invitedAt      DateTime?
  viewedAt       DateTime?
  submittedAt    DateTime?
  withdrawnAt    DateTime?
  disqualifiedAt DateTime?

  @@index([tenderId])
  @@index([supplierId])
}

model TenderPersonnelAssignment {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  supplierId  String
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id])

  requirementId String?
  requirement   TenderPersonnelRequirement? @relation(fields: [requirementId], references: [id])

  assignmentStatus AssignmentStatus @default(PROPOSED)
  proposedRate     Decimal?
  aiMatchScore     Decimal? // For Wave 6

  @@index([tenderId])
  @@index([personnelId])
}

model TenderEquipmentAssignment {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  supplierId  String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  requirementId String?
  requirement   TenderEquipmentRequirement? @relation(fields: [requirementId], references: [id])

  assignmentStatus AssignmentStatus @default(PROPOSED)
  proposedRate     Decimal?
  aiMatchScore     Decimal? // For Wave 6

  @@index([tenderId])
  @@index([equipmentId])
}

// --- Documents & Evaluation ---

model TenderDocument {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  documentType TenderDocumentType @default(OTHER)
  supplierId   String? // If uploaded by a bidding supplier

  @@index([tenderId])
  @@index([documentId])
}

model TenderEvaluation {
  id       String @id @default(cuid())
  tenderId String
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  supplierId String

  // Separated scoring dimensions
  technicalScore Decimal @default(0)
  financialScore Decimal @default(0)
  manualScore    Decimal @default(0)

  aiPersonnelScore Decimal @default(0)
  aiEquipmentScore Decimal @default(0)
  aiDocumentScore  Decimal @default(0)
  aiRiskScore      Decimal @default(0)
  aiFinalScore     Decimal @default(0)

  totalScore Decimal @default(0)

  evaluationNotes String?  @db.Text
  evaluatedBy     String?
  evaluatedAt     DateTime @default(now())

  @@index([tenderId])
  @@index([supplierId])
}

// ==========================================
// TRUST ENGINE DOMAIN (Wave 5.10 / EP2-S04)
// ==========================================

enum TrustVerificationStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  VERIFIED
  SUSPENDED
  EXPIRED
  REVOKED
}

model TrustEvidence {
  id String @id @default(cuid())

  workspaceId String? // Optional workspace binding for tenant isolation
  entityType  EntityType
  entityId    String

  type        String // NIB, NPWP, SBU, etc.
  title       String
  description String? @db.Text
  assetId     String? // Reference to CompanyAsset or Document

  issuer    String?
  issuedAt  DateTime?
  expiresAt DateTime?

  status   TrustVerificationStatus @default(DRAFT)
  metadata Json? // Arbitrary JSON for evidence specifics

  reviewerId         String?
  verificationResult Json? // Feedback, notes from reviewer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model TrustProjection {
  id String @id @default(cuid())

  entityType EntityType
  entityId   String

  status TrustVerificationStatus @default(DRAFT)
  score  Int                     @default(0)

  verifiedItems Json? // Array of strings e.g. ["NIB", "NPWP"]
  expiredItems  Json? // Array of strings
  warnings      Json? // Array of strings
  badges        Json? // Array of badge keys

  lastCalculatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
}

model TrustAuditLog {
  id String @id @default(cuid())

  entityType EntityType
  entityId   String
  evidenceId String?

  actorId       String
  action        String // e.g. "REQUEST_VERIFICATION", "APPROVE"
  previousState String?
  newState      String?
  reason        String? @db.Text

  timestamp DateTime @default(now())

  @@index([entityType, entityId])
}

// ==========================================
// AI PLATFORM FOUNDATION (Wave 7 / EP2-S05)
// ==========================================

enum AIConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model AIConversation {
  id          String  @id @default(cuid())
  workspaceId String
  title       String?

  status AIConversationStatus @default(ACTIVE)

  createdBy    String?
  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  // Extension point for AI Memory
  // memoryId String?

  messages  AIMessage[]
  artifacts AIArtifact[]

  @@index([workspaceId])
  @@index([createdAt])
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AIMessageRole
  content Json? // Stored as JSON to handle complex blocks (text, tool calls, tool results)

  // Telemetry (populated if role == ASSISTANT)
  provider         String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  latency          Int? // in ms
  estimatedCost    Float?
  rating           Int? // 1-5 User Rating

  createdAt DateTime @default(now())

  @@index([conversationId])
}

enum AIArtifactStatus {
  DRAFT
  FINAL
  SUPERSEDED
}

model AIArtifact {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  type     String // e.g., "COMPANY_PROFILE", "SEO_AUDIT", "SUGGESTION_SET"
  title    String?
  content  Json // The actual generated content/document
  metadata Json? // Any references, source sections used

  status AIArtifactStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suggestions AISuggestion[]

  @@index([conversationId])
}

enum AISuggestionOperation {
  ADD
  REPLACE
  REMOVE
  APPEND
  MERGE
}

enum AISuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
  SUPERSEDED
}

model AISuggestion {
  id         String      @id @default(cuid())
  artifactId String?
  artifact   AIArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  entityType  String // e.g., "COMPANY"
  entityId    String
  targetField String // e.g., "profile.about"

  operation AISuggestionOperation
  payload   Json // Contains the old and new states based on the operation

  reason     String? @db.Text
  confidence Float?
  category   String?

  status AISuggestionStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([entityType, entityId])
  @@index([artifactId])
}

// --- KNOWLEDGE PLATFORM ---

model KnowledgeNode {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  entityId    String? @map("entity_id") // Universal object reference
  label       String
  properties  Json?

  // Metadata
  nodeType    String @map("node_type") // e.g., 'COMPANY', 'SKILL', 'TENDER'
  domain      String // e.g., 'CORE', 'FINANCE', 'PROJECT'
  status      String @default("ACTIVE") // 'ACTIVE', 'DRAFT', 'ARCHIVED'
  visibility  String @default("PRIVATE") // 'PRIVATE', 'WORKSPACE', 'PUBLIC'
  version     Int    @default(1)
  fingerprint String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  embeddings    KnowledgeEmbedding[]
  outgoingEdges SemanticRelationship[] @relation("SourceNode")
  incomingEdges SemanticRelationship[] @relation("TargetNode")

  @@index([workspaceId, nodeType])
  @@index([entityId])
  @@map("knowledge_nodes")
}

model KnowledgeEmbedding {
  id                 String   @id @default(uuid())
  knowledgeNodeId    String   @map("knowledge_node_id")
  provider           String // e.g., 'mock', 'openai'
  model              String // e.g., 'text-embedding-3-small'
  dimension          Int // e.g., 1536
  hash               String // content hash to detect changes
  embeddingReference String   @map("embedding_reference") // External reference ID
  generatedAt        DateTime @default(now()) @map("generated_at")

  node KnowledgeNode @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)

  @@index([knowledgeNodeId])
  @@map("knowledge_embeddings")
}

model SemanticRelationship {
  id        String @id @default(uuid())
  sourceId  String @map("source_id")
  targetId  String @map("target_id")
  predicate String // e.g. "HAS_SKILL", "OWNS_EQUIPMENT"

  direction  String @default("DIRECTED") // 'DIRECTED', 'UNDIRECTED', 'BIDIRECTIONAL'
  confidence Float  @default(1.0)
  source     String @default("SYSTEM") // 'SYSTEM', 'AI', 'USER'

  weight     Float    @default(1.0)
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")

  sourceNode KnowledgeNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode KnowledgeNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId, predicate])
  @@index([targetId, predicate])
  @@map("semantic_relationships")
}

model KnowledgeSnapshot {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  version         Int
  nodesCount      Int      @default(0) @map("nodes_count")
  edgesCount      Int      @default(0) @map("edges_count")
  embeddingsCount Int      @default(0) @map("embeddings_count")
  fingerprint     String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("knowledge_snapshots")
}

// --- COGNITIVE OPERATING SYSTEM (AI-03B) ---

enum CognitiveMemoryType {
  CONVERSATION
  WORKING
  DECISION
  EXECUTION
  REFLECTION
}

model CognitiveSession {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  aiConversationId String?  @map("ai_conversation_id")
  status           String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  goals CognitiveGoal[]

  @@index([workspaceId])
  @@map("cognitive_sessions")
}

model CognitiveGoal {
  id        String @id @default(uuid())
  sessionId String @map("session_id")
  title     String
  status    String @default("PENDING") // PENDING, ACTIVE, WAITING_APPROVAL, COMPLETED, FAILED, CANCELLED
  priority  String @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  initiator String // e.g. "SYSTEM", "USER"
  version   Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session CognitiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  plans     CognitivePlan[]
  decisions CognitiveDecision[]
  memories  CognitiveMemory[]
  lessons   CognitiveLesson[]
  telemetry CognitiveTelemetry[]

  @@index([sessionId])
  @@map("cognitive_goals")
}

model CognitiveMemory {
  id        String              @id @default(uuid())
  goalId    String              @map("goal_id")
  type      CognitiveMemoryType
  content   Json
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at")

  goal CognitiveGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, type])
  @@map("cognitive_memories")
}

model CognitiveDecision {
  id           String   @id @default(uuid())
  goalId       String   @map("goal_id")
  alternatives Json // Array of alternatives
  selected     Json // Selected alternative
  score        Float
  confidence   Float
  explanation  String   @db.Text
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  goal CognitiveGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("cognitive_decisions")
}

model CognitivePlan {
  id                String   @id @default(uuid())
  goalId            String   @map("goal_id")
  planType          String // LOGICAL, COMPILED
  executionGraph    Json? // DAG output
  estimatedCost     Float?
  estimatedDuration Int? // in seconds
  criticalPath      Json?
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")

  goal  CognitiveGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks CognitiveTask[]

  @@index([goalId])
  @@map("cognitive_plans")
}

model CognitiveTask {
  id           String @id @default(uuid())
  planId       String @map("plan_id")
  name         String
  status       String @default("READY") // READY, RUNNING, WAITING, FAILED, RETRYING, COMPLETED, CANCELLED, WAITING_APPROVAL
  priority     Int    @default(0)
  retryCount   Int    @default(0)
  maxRetries   Int    @default(3)
  timeoutMs    Int    @default(30000)
  dependencies Json? // Array of Task IDs
  payload      Json?
  version      Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan CognitivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
  @@map("cognitive_tasks")
}

model CognitiveLesson {
  id              String   @id @default(uuid())
  goalId          String   @map("goal_id")
  lessonType      String // KNOWLEDGE_UPDATE, IMPROVEMENT_SUGGESTION
  content         Json
  knowledgeNodeId String?  @map("knowledge_node_id")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  goal CognitiveGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, lessonType])
  @@map("cognitive_lessons")
}

model CognitiveTelemetry {
  id           String   @id @default(uuid())
  goalId       String   @map("goal_id")
  traceId      String
  spanId       String
  parentSpanId String?
  durationMs   Int
  status       String // OK, ERROR
  component    String // e.g. "ReasoningEngine", "RuleEngine"
  metrics      Json? // memorySize, ruleCount, constraintCount
  createdAt    DateTime @default(now()) @map("created_at")

  goal CognitiveGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, traceId])
  @@map("cognitive_telemetry")
}

// --- AI SERVICE MESH (AI-04B) ---

model PersistentCapability {
  id                String  @id
  version           Int     @default(1)
  domain            String
  description       String? @db.Text
  inputSchema       Json
  outputSchema      Json
  requiredTools     Json?
  requiredKnowledge Json?
  requiredPolicies  Json?

  status    String   @default("ACTIVE") // DRAFT, ACTIVE, DEPRECATED, DISABLED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("persistent_capabilities")
}

model PersistentWorkflow {
  id            String  @id
  version       Int     @default(1)
  owner         String?
  tags          Json?
  compatibility Json? // e.g. SDK version
  status        String  @default("ACTIVE") // DRAFT, ACTIVE, DEPRECATED, DISABLED

  executionGraph Json
  approvalRules  Json?
  rollbackRules  Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("persistent_workflows")
}

model MeshService {
  id            String   @id
  name          String
  url           String
  healthStatus  String   @default("HEALTHY")
  lastHeartbeat DateTime @default(now())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mesh_services")
}

model MeshMetric {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  metricName  String
  metricValue Float
  dimensions  Json? // e.g. { capability: "COMPANY_SEO_AUDIT" }

  @@index([metricName, timestamp])
  @@map("mesh_metrics")
}

model EventStore {
  id             String @id @default(uuid())
  eventId        String @unique
  eventType      String
  classification String
  priority       String
  pii            String

  aggregateId   String
  aggregateType String
  workspaceId   String
  version       Int

  payload  Json
  metadata Json?

  correlationId String
  causationId   String
  traceId       String
  spanId        String
  parentSpanId  String?

  timestamp DateTime @default(now())

  @@index([aggregateId, aggregateType, version])
  @@index([correlationId])
  @@map("event_store")
}

model EventSnapshot {
  id            String @id @default(uuid())
  aggregateId   String
  aggregateType String
  version       Int
  state         Json

  timestamp DateTime @default(now())

  @@unique([aggregateId, aggregateType])
  @@map("event_snapshots")
}

model EventDLQ {
  id           String @id @default(uuid())
  eventId      String
  subscriberId String
  errorReason  String
  retryCount   Int    @default(0)

  payload  Json
  metadata Json?

  timestamp DateTime @default(now())

  @@index([subscriberId, eventId])
  @@map("event_dlq")
}

model RegisteredSubscriber {
  id          String @id
  name        String
  eventTypes  Json // list of subscribed event types
  priority    Int
  concurrency Int
  retryPolicy Json // configuration for retry backoff
  status      String @default("ACTIVE") // ACTIVE, DISABLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("registered_subscribers")
}
