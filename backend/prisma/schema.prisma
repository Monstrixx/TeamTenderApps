generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  username         String?               @unique
  passwordHash     String
  name             String
  tokenVersion     Int                   @default(0)
  lastLogin        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  roles            UserRole[]
  workspaces       Workspace[]
  workspaceMembers WorkspaceMember[]
  refreshTokens    RefreshToken[]
  sentInvitations  WorkspaceInvitation[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Workspace {
  id String @id @default(cuid())

  code        String  @unique
  name        String
  description String?

  status WorkspaceStatus @default(ACTIVE)

  ownerId String

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  companies   Company[]
  suppliers   Supplier[]
  personnels  Personnel[]
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  deviceId  String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// WORKSPACE COLLABORATION DOMAIN (Wave 6)
// ==========================================

enum WorkspacePermission {
  WORKSPACE_READ
  WORKSPACE_UPDATE
  WORKSPACE_DELETE
  WORKSPACE_RESTORE
  MEMBER_READ
  MEMBER_CREATE
  MEMBER_UPDATE
  MEMBER_DELETE
  INVITATION_READ
  INVITATION_CREATE
  INVITATION_DELETE
  ROLE_READ
}

enum WorkspaceRoleType {
  OWNER
  ADMINISTRATOR
  MANAGER
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

model WorkspaceRole {
  id          String                @id @default(cuid())
  name        String                @unique
  type        WorkspaceRoleType
  description String?
  permissions WorkspacePermission[] // Enum array

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String
  status      MemberStatus @default(ACTIVE)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id])

  joinedAt     DateTime?
  lastActiveAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // For soft delete

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  displayName String?
  roleId      String
  token       String           @unique
  status      InvitationStatus @default(PENDING)

  inviterId String

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id])
  inviter   User          @relation(fields: [inviterId], references: [id])

  expiresAt  DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([email])
}

enum AuditLevel {
  INFO
  WARNING
  SECURITY
  SYSTEM
}

model AuditLog {
  id String @id @default(cuid())

  event      String
  level      AuditLevel @default(INFO)
  entityType String
  entityId   String?

  workspaceId String?
  userId      String?

  requestId     String?
  correlationId String?

  ipAddress String?
  userAgent String?

  payload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC
  UNLISTED
  ARCHIVED
}

enum CompanyVerificationStatus {
  VERIFIED
  PENDING
  REJECTED
  EXPIRED
}

enum CompanyBusinessType {
  PT
  CV
  UD
  BUMN
  BUMD
  YAYASAN
  KOPERASI
  LAINNYA
}

enum AddressType {
  HEAD_OFFICE
  BRANCH
  PROJECT
  WAREHOUSE
}

model Company {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  code               String                    @unique
  slug               String                    @unique
  name               String
  legalName          String?
  version            Int                       @default(1)
  businessType       CompanyBusinessType
  status             CompanyStatus
  visibility         CompanyVisibility         @default(PRIVATE)
  verificationStatus CompanyVerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  email           String?
  phone           String?
  website         String?
  logoUrl         String?
  description     String?
  establishedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  addresses    CompanyAddress[]
  legal        CompanyLegal?
  contacts     CompanyContact[]
  bankAccounts CompanyBankAccount[]
  timeline     CompanyTimeline[]
  assets       CompanyAsset[]
  profile      CompanyProfile?
  brandKit     CompanyBrandKit?
  portfolios   CompanyPortfolio[]
  products     CompanyProduct[]
  services     CompanyService[]
  activities   CompanyActivity[]
  downloads    CompanyDownload[]

  // Future Relations (Wave 6+)
  suppliers  Supplier[]
  // personnel    Personnel[]
  // equipment    Equipment[]
  documents  CompanyDocument[]
  // certifications Certification[]
  // experience   Experience[]
  // financialReports FinancialReport[]
  // licenses     License[]
  personnels Personnel[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
}

model CompanyLegal {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  nib                    String?
  npwp                   String?
  pkpNumber              String?
  deedNumber             String?
  deedDate               DateTime?
  ministryApprovalNumber String?
  ministryApprovalDate   DateTime?

  taxOffice      String?
  businessSector String?
  kbli           String?
  capital        Decimal?
  employeeCount  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyAddress {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  type       AddressType
  province   String
  city       String
  district   String
  village    String
  postalCode String
  address    String
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean     @default(false)
}

enum CompanyDocumentType {
  DEED_OF_ESTABLISHMENT
  MINISTRY_APPROVAL
  NIB
  NPWP
  SKT
  SPPKP
  BUSINESS_LICENSE
  OTHER
}

model CompanyDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       CompanyDocumentType
  documentId String
  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([documentId])
}

model CompanyContact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fullName    String
  position    String?
  email       String?
  phone       String?
  mobilePhone String?
  department  String?
  notes       String?
  isPrimary   Boolean @default(false)

  @@index([companyId])
}

model CompanyBankAccount {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  bankName      String
  bankBranch    String?
  accountNumber String
  accountHolder String
  swiftCode     String?
  currency      String  @default("IDR")
  isPrimary     Boolean @default(false)

  @@index([companyId])
}

model CompanyTimeline {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year        Int
  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([year])
}

enum CompanyAssetType {
  IMAGE
  VIDEO
  DOCUMENT
  ARCHIVE
  OTHER
}

model CompanyAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type     CompanyAssetType
  url      String
  mimeType String?
  size     Int? // bytes
  filename String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyBrandKit {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  fontFamily       String?
  typography       Json?
  logoAssetId      String? // Reference to CompanyAsset, but kept as string ID
  lightLogoAssetId String?
  darkLogoAssetId  String?
  faviconAssetId   String? // Reference to CompanyAsset
  brandSlogan      String?
  ctaLabel         String?
  ctaUrl           String?
  themeConfig      Json? // Extension point for Theme System

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  heroAssetId String? // Reference to CompanyAsset
  about       String? @db.Text
  vision      String? @db.Text
  mission     String? @db.Text

  // SEO Meta
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  // JSON array for gallery (array of asset IDs)
  galleryAssetIds String? // JSON string
  layoutConfig    Json? // Extension point for Block Layout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyPortfolio {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title           String
  category        String?
  client          String?
  location        String?
  description     String?   @db.Text
  completionDate  DateTime?
  contractValue   Decimal?
  coverAssetId    String?
  galleryAssetIds String? // JSON string array
  relatedServices String? // JSON string array
  relatedProducts String? // JSON string array
  semanticTags    Json? // Extension point for Knowledge Graph
  featured        Boolean   @default(false)
  displayOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyProduct {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name             String
  slug             String  @unique
  category         String?
  shortDescription String?
  fullDescription  String? @db.Text
  specifications   Json?
  coverAssetId     String?
  galleryAssetIds  String? // JSON string array
  downloadAssetIds String? // JSON string array
  semanticTags     Json? // Extension point for Knowledge Graph
  featured         Boolean @default(false)
  active           Boolean @default(true)
  displayOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CompanyService {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name             String
  category         String?
  description      String? @db.Text
  icon             String?
  heroAssetId      String?
  galleryAssetIds  String? // JSON string array
  relatedPortfolio String? // JSON string array
  semanticTags     Json? // Extension point for Knowledge Graph
  featured         Boolean @default(false)
  active           Boolean @default(true)
  displayOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum CompanyActivityCategory {
  ACHIEVEMENT
  CERTIFICATION
  PROJECT
  AWARD
  MILESTONE
  NEWS
  EVENT
}

model CompanyActivity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title        String
  summary      String?                 @db.Text
  date         DateTime
  category     CompanyActivityCategory
  coverAssetId String?
  visibility   CompanyVisibility       @default(PUBLIC)
  featured     Boolean                 @default(false)

  // Extension point for Generic Activity Stream
  relatedEntityType String?
  relatedEntityId   String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum CompanyDownloadCategory {
  PROFILE
  BROCHURE
  CATALOGUE
  CERTIFICATE
  PRESENTATION
  OTHER
}

model CompanyDownload {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title      String
  category   CompanyDownloadCategory
  assetId    String
  version    String?
  language   String?                 @default("en")
  visibility CompanyVisibility       @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ==========================================
// SUPPLIER DOMAIN (Wave 5.5)
// ==========================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  ARCHIVED
}

enum SupplierCategory {
  CONTRACTOR
  CONSULTANT
  MANUFACTURER
  DISTRIBUTOR
  SERVICE
  OTHER
}

enum SupplierBusinessType {
  PT
  CV
  UD
  BUMN
  BUMD
  YAYASAN
  KOPERASI
  LAINNYA
}

model Supplier {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code    String @unique
  slug    String @unique
  version Int    @default(1)

  name         String
  displayName  String?
  businessType SupplierBusinessType
  category     SupplierCategory
  status       SupplierStatus

  email       String?
  phone       String?
  website     String?
  logoUrl     String?
  description String?

  profileScore   Int     @default(0)
  normalizedName String? @db.VarChar(255)
  searchKeywords String? @db.Text
  aliases        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  contacts     SupplierContact[]
  bankAccounts SupplierBankAccount[]
  tax          SupplierTax?

  qualifications  SupplierQualification[]
  experiences     SupplierExperience[]
  rating          SupplierRating?
  embeddings      SupplierEmbedding[]
  tenderSuppliers TenderSupplier[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  fullName    String
  position    String?
  email       String?
  phone       String?
  mobilePhone String?
  department  String?
  notes       String?
  isPrimary   Boolean @default(false)

  @@index([supplierId])
}

model SupplierBankAccount {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bankName      String
  bankBranch    String?
  accountNumber String
  accountHolder String
  swiftCode     String?
  currency      String  @default("IDR")
  isPrimary     Boolean @default(false)

  @@index([supplierId])
}

model SupplierTax {
  id         String   @id @default(cuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  npwp      String?
  pkpNumber String?
  taxOffice String?
}

enum QualificationType {
  SIBUJK
  ISO
  SBU
  NIB
  NPWP
  OTHER
}

enum QualificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

model SupplierQualification {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  type           QualificationType
  documentNumber String?
  issuer         String?
  validFrom      DateTime?
  validUntil     DateTime?
  fileId         String?
  file           Document?         @relation(fields: [fileId], references: [id], onDelete: SetNull)

  status     QualificationStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  remarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([fileId])
}

enum ProjectCategory {
  BUILDING
  ROAD
  BRIDGE
  IRRIGATION
  ELECTRICAL
  MECHANICAL
  IT
  OTHER
}

model SupplierExperience {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  projectName      String
  ownerName        String
  contractValue    Decimal?
  currency         String    @default("IDR")
  exchangeRate     Decimal?
  exchangeRateDate DateTime?
  completionYear   Int?
  bastDate         DateTime?
  bastNumber       String?

  projectLocation  String?
  clientType       String?
  projectCategory  ProjectCategory?
  scopeOfWork      String?
  referenceContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

model SupplierRating {
  id         String   @id @default(cuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  quality        Decimal  @default(0)
  delivery       Decimal  @default(0)
  administration Decimal  @default(0)
  finance        Decimal  @default(0)
  overall        Decimal? // Derived field computed by service

  evaluationMethod String?
  evaluatedBy      String?
  evaluationNotes  String?

  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierEmbedding {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  provider  String
  model     String
  dimension Int

  createdAt DateTime @default(now())

  @@index([supplierId])
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  CHRISTIAN
  CATHOLIC
  HINDU
  BUDDHIST
  CONFUCIAN
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum PersonnelStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum EducationLevel {
  SD
  SMP
  SMA
  SMK
  D3
  D4
  S1
  S2
  S3
}

enum DocumentType {
  KTP
  KK
  NPWP
  IJAZAH
  SKK
  SERTIFIKAT
  PAKLARING
  SIM
  PASSPORT
  BPJS
  PHOTO
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum ProviderType {
  LPJK
  BNSP
  PUPR
  MANUAL
  MOCK
}

enum SkillCategory {
  TECHNICAL
  MANAGEMENT
  SOFT_SKILL
  LANGUAGE
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillSource {
  SELF_DECLARATION
  SKK
  TRAINING
  PROJECT_EXPERIENCE
  MANUAL_VERIFICATION
}

model Personnel {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code    String @unique
  slug    String @unique
  version Int    @default(1)

  employeeNumber String?
  nik            String?
  fullName       String
  birthPlace     String?
  birthDate      DateTime?
  gender         Gender?
  religion       Religion?
  maritalStatus  MaritalStatus?

  email   String?
  phone   String?
  address String?
  photo   String?

  status PersonnelStatus @default(ACTIVE)

  normalizedName String? @db.VarChar(255)
  searchKeywords String? @db.Text
  aliases        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  educations                 PersonnelEducation[]
  experiences                PersonnelExperience[]
  skk                        PersonnelSKK[]
  documents                  PersonnelDocument[]
  tenderDocuments            TenderPersonnelDocument[]
  assignments                PersonnelAssignment[]
  embeddings                 PersonnelEmbedding[]
  skills                     PersonnelSkill[]
  featureVector              PersonnelFeatureVector?
  tenderPersonnelAssignments TenderPersonnelAssignment[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model PersonnelEducation {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  level          EducationLevel
  major          String?
  institution    String
  graduationYear Int
  gpa            Decimal?
  documentId     String?
  document       Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
  @@index([documentId])
}

model PersonnelExperience {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  companyName      String
  position         String
  projectName      String?
  projectValue     Decimal?
  durationMonths   Int?
  ownerName        String?
  referenceName    String?
  referenceContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
}

model PersonnelSKK {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  certificateNumber String
  qualification     String
  subClassification String?
  level             String?
  issuer            String
  issuedDate        DateTime
  expiredDate       DateTime
  documentId        String?
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  verificationStatus    VerificationStatus @default(PENDING)
  verificationSource    String?
  verificationTime      DateTime?
  verificationReference String?

  history PersonnelSKKHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
}

model PersonnelDocument {
