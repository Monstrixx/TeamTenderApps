  "signature": {
    "publisher": "TeamTender Root CA",
    "signature": "SIG_GOLDEN_REF_COMPANY_V1",
    "checksum": "CHECKSUM_COMPANY_V1_HASH",
    "buildHash": "BUILD_HASH_COMPANY_V1"
  }
