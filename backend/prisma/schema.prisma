  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  type       DocumentType
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
  @@index([documentId])
}

model TenderPersonnelDocument {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  tenderId     String?
  documentType String
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
  @@index([documentId])
}

model PersonnelAssignment {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  tenderId   String?
  projectId  String?
  role       String
  startDate  DateTime?
  finishDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
}

model PersonnelEmbedding {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  provider  String
  model     String
  dimension Int
  version   Int    @default(1)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([personnelId])
}

model PersonnelSKKHistory {
  id    String       @id @default(cuid())
  skkId String
  skk   PersonnelSKK @relation(fields: [skkId], references: [id], onDelete: Cascade)

  certificateNumber String
  qualification     String
  subClassification String?
  level             String?
  issuer            String
  issuedDate        DateTime
  expiredDate       DateTime
  documentId        String?
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  verificationStatus    VerificationStatus @default(PENDING)
  verificationReference String?

  changeReason String?

  createdAt DateTime @default(now())

  @@index([skkId])
}

model PersonnelSkill {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  skillName         String
